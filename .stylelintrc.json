{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "config",
          "screen",
          "responsive",
          "variants"
        ]
      }
    ],
    "function-no-unknown": [
      true,
      {
        "ignoreFunctions": ["theme"]
      }
    ],
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "no-descending-specificity": null
  },
  "ignoreFiles": ["**/*.min.css", "**/dist/**", "**/node_modules/**"]
}
