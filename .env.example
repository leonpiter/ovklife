# ============================================================================
# OVKLife WordPress — Переменные окружения (шаблон)
# ============================================================================
# Скопировать в .env и заполнить реальными значениями.
# .env файл НЕ коммитится в git!
# ============================================================================

# База данных
DB_NAME=ovklife_dev
DB_USER=wp_user
DB_PASSWORD=wp_password
DB_HOST=mysql

# WordPress
WP_DEBUG=true
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# Сервер (для деплоя)
STAGING_HOST=62.113.102.129
STAGING_USER=root
STAGING_PATH=/var/www/staging.ovklife.ru

PROD_HOST=62.113.102.129
PROD_USER=root
PROD_PATH=/var/www/ovklife.ru
